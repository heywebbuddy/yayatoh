# /etc/yayatoh/deploy.env on the server (root only). Not secret; secrets live in Doppler.
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=
APP_HOST=app.yayatoh.com
ADMIN_HOST=admin.yayatoh.com
# Postgres memory: about 1/4 and 3/4 of the server's RAM (24 GB server: 6GB / 18GB).
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
# Where the release images live (public package on GitHub Container Registry).
YAYATOH_IMAGE_REPO=ghcr.io/heywebbuddy/yayatoh
