# The only public entry point (ADR 0024). Caddy terminates TLS, gets certificates from Let's Encrypt
# (the platform hosts up front, tenant hosts on demand after asking the web app), and forwards to
# the containers on the private network. Hostnames come from the environment (/etc/yayatoh/deploy.env, from deploy/deploy.env.example).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://web:3000/api/internal/tls-ask
	}
	servers {
		# Long-lived Server-Sent Events (seat maps, door screens) stay open.
		timeouts {
			read_body 2m
			idle 5m
		}
	}
}

(proxy_headers) {
	# Only Caddy speaks for the client: drop anything a browser sent that would claim a country or
	# an address (risk rules and rate limits read these), then set the real client address.
	request_header -X-Vercel-IP-Country
	request_header -X-Real-IP
	encode zstd gzip
}

(to_web) {
	import proxy_headers
	# Caddy's internal TLS check and the internal routes are never public.
	@internal path /api/internal/tls-ask
	respond @internal 404
	request_body {
		max_size 70MB
	}
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
		# Stream responses as they are written (SSE).
		flush_interval -1
	}
}

{$APP_HOST:app.yayatoh.com} {
	import to_web
}

{$ADMIN_HOST:admin.yayatoh.com} {
	import proxy_headers
	reverse_proxy admin:3001 {
		header_up X-Real-IP {remote_host}
	}
}

# The tenant domains: `{slug}.yayatoh.events` and organizers' own domains. A certificate is issued
# the first time a host is visited, only if /api/internal/tls-ask says the host belongs to an org.
# The marketplace hosts (yayatoh.com) join here at cutover, when their DNS moves to this server.
https:// {
	tls {
		on_demand
	}
	import to_web
}

# Plain HTTP: everything moves to HTTPS (Caddy also answers ACME challenges here).
http:// {
	redir https://{host}{uri} 308
}
