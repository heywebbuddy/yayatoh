{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/docs",
      "!**/drizzle/meta",
      "!**/*.md",
      "!**/next-env.d.ts",
      "!**/openapi.json",
      "!tools/automation-apps/generated",
      "!packages/sdk/src/schema.ts",
      "!packages/modules/media/fixtures"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error", "useImportType": "error" },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn", "info"] } }
      },
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
