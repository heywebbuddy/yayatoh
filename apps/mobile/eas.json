{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "APP_ENV": "development" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_ENV": "preview" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_ENV": "production" }
    },
    "e2e-ios": {
      "distribution": "internal",
      "channel": "e2e",
      "env": { "APP_ENV": "preview", "API_BASE_URL": "https://e2e-server.invalid/api/v1" },
      "ios": { "simulator": true }
    },
    "e2e-android": {
      "distribution": "internal",
      "channel": "e2e",
      "env": { "APP_ENV": "preview", "API_BASE_URL": "https://e2e-server.invalid/api/v1" },
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {}
  }
}
