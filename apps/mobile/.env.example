# Read by app.config.ts (Expo loads .env into the process before evaluating it). Nothing here is a
# credential: store and Expo accounts are owner actions (docs/owner-inbox.md). Copy to .env to use.

# development | preview | production (EAS profiles in eas.json set it for builds)
APP_ENV=development

# Default: http://localhost:3000/api/v1 in development, https://app.yayatoh.com/api/v1 otherwise.
# A phone cannot reach "localhost": use the Mac's LAN address, e.g. http://192.168.1.20:3000/api/v1
# (plain http is refused outside development).
# API_BASE_URL=

# Production store identifiers (P7-4: the existing Yayatoh listing's IDs). Preview and development
# builds add ".preview" / ".dev" so all three install side by side.
# IOS_BUNDLE_ID=
# ANDROID_PACKAGE=

# Tenant link host: universal links for {slug}.<this domain> (default yayatoh.events).
# TENANT_LINK_DOMAIN=

# EAS project and Expo account (needed only for EAS Build and EAS Update).
# EAS_PROJECT_ID=
# EXPO_OWNER=

# Crash reports (P7-11). Empty or unset: Sentry stays off. A DSN is an account value, not a secret
# key, but it belongs to the owner's Sentry project, so it comes from the environment.
# SENTRY_DSN=

# Sign in with Google (M7.1c): the OAuth client ids for this app (public identifiers, not secrets).
# iOS:     <number>-<id>.apps.googleusercontent.com   (redirect scheme com.googleusercontent.apps.<number>-<id>)
# Android: the Android-type client for ANDROID_PACKAGE (redirect scheme = the package name)
# Unset: the app has no Google button. The server must list the same ids in GOOGLE_MOBILE_CLIENT_IDS.
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# Push (M7.3d): the path to the Firebase client file (google-services.json) of the owner's FCM project,
# as an EAS file secret. Unset: Android builds have no push. iOS needs no file; its APNs key is an
# owner account value set on the server (PUSH_PROVIDER, M7.2c).
# GOOGLE_SERVICES_FILE=
