{
  "app": "mobile",
  "$comment": "Screenshot plan (M7.5a). `store/capture.sh` runs each screen's Maestro flow on each device in light and dark and saves PNGs to the layout below; `store-kit shots` checks the folder. Nothing runs in a cloud session (no simulator): this is the device pass.",
  "outputLayout": "apps/mobile/store/screenshots/<platform>/<locale>/<device>/<theme>/<order>-<screen>.png",
  "themes": ["light", "dark"],
  "locales": ["en"],
  "otherLocales": "Capture the other 12 locales after English by choosing the language in Account > Language (attendee app) or the phone language (Staff), then re-run capture.sh --locale <code>. Store captions are not baked into the PNGs.",
  "devices": [
    {
      "id": "iphone-6.9",
      "platform": "ios",
      "store": "App Store",
      "width": 1320,
      "height": 2868,
      "required": true,
      "simulator": "iPhone 17 Pro Max",
      "note": "6.9-inch set; App Store Connect scales it down for smaller iPhones"
    },
    {
      "id": "iphone-6.5",
      "platform": "ios",
      "store": "App Store",
      "width": 1284,
      "height": 2778,
      "required": false,
      "simulator": "iPhone 14 Plus",
      "note": "Only if the 6.9-inch set is not used"
    },
    {
      "id": "ipad-13",
      "platform": "ios",
      "store": "App Store",
      "width": 2064,
      "height": 2752,
      "required": true,
      "simulator": "iPad Pro 13-inch (M5)",
      "note": "Required because the app runs on iPad (supportsTablet)"
    },
    {
      "id": "android-phone",
      "platform": "android",
      "store": "Google Play",
      "width": 1080,
      "height": 1920,
      "required": true,
      "emulator": "Pixel_8_API_35",
      "note": "Phone set, 9:16"
    },
    {
      "id": "android-tablet-10",
      "platform": "android",
      "store": "Google Play",
      "width": 1600,
      "height": 2560,
      "required": false,
      "emulator": "Pixel_Tablet_API_35",
      "note": "Optional 10-inch tablet set; lifts the tablet ranking"
    }
  ],
  "screens": [
    {
      "id": "discover",
      "flow": ".maestro/store/01-discover.yaml",
      "devices": ["iphone-6.9", "android-phone", "ipad-13", "android-tablet-10"],
      "caption": "Find events near you"
    },
    {
      "id": "event",
      "flow": ".maestro/store/02-event.yaml",
      "devices": ["iphone-6.9", "android-phone", "ipad-13", "android-tablet-10"],
      "caption": "See the date, place and tickets"
    },
    {
      "id": "checkout",
      "flow": ".maestro/store/03-checkout.yaml",
      "devices": ["iphone-6.9", "android-phone", "ipad-13", "android-tablet-10"],
      "caption": "Pay in a secure checkout"
    },
    {
      "id": "tickets",
      "flow": ".maestro/store/04-tickets.yaml",
      "devices": ["iphone-6.9", "android-phone", "ipad-13", "android-tablet-10"],
      "caption": "All your tickets in one place"
    },
    {
      "id": "ticket-qr",
      "flow": ".maestro/store/05-ticket-qr.yaml",
      "devices": ["iphone-6.9", "android-phone", "ipad-13", "android-tablet-10"],
      "caption": "Your QR code, even offline"
    },
    {
      "id": "account",
      "flow": ".maestro/store/06-account.yaml",
      "devices": ["iphone-6.9", "android-phone", "ipad-13", "android-tablet-10"],
      "caption": "You control your account and notifications"
    }
  ]
}
