{
  "openapi": "3.1.0",
  "info": {
    "title": "Yayatoh API",
    "version": "0.1.0",
    "description": "Yayatoh /v1. Changes are additive only (oasdiff gate)."
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scanner device token (`yyd_…`), issued once at enrollment."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/manifest": {
      "get": {
        "tags": [
          "scanner"
        ],
        "summary": "Offline manifest page for a scanner device",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "eventId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "overlap",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Manifest page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": {
                      "type": "object",
                      "properties": {
                        "event": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "startsAt": {
                              "type": "string"
                            },
                            "endsAt": {
                              "type": "string"
                            },
                            "timezone": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "startsAt",
                            "endsAt",
                            "timezone"
                          ]
                        },
                        "publicKeys": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "salt": {
                          "type": "string"
                        },
                        "serverTime": {
                          "type": "string"
                        },
                        "unknownPolicy": {
                          "type": "string",
                          "enum": [
                            "provisional",
                            "reject"
                          ]
                        }
                      },
                      "required": [
                        "event",
                        "publicKeys",
                        "salt",
                        "serverTime",
                        "unknownPolicy"
                      ]
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticketId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "shortCode": {
                            "type": "string"
                          },
                          "rev": {
                            "type": "integer"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "void"
                            ]
                          },
                          "typeName": {
                            "type": "string"
                          },
                          "accessDates": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "date": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "date",
                                "name"
                              ]
                            }
                          },
                          "holderName": {
                            "type": "string"
                          },
                          "emailHash": {
                            "type": "string"
                          },
                          "issuedAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "ticketId",
                          "shortCode",
                          "rev",
                          "status",
                          "typeName",
                          "accessDates",
                          "holderName",
                          "emailHash",
                          "issuedAt"
                        ]
                      }
                    },
                    "cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "complete": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "header",
                    "rows",
                    "cursor",
                    "complete"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown device token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/scans/batch": {
      "post": {
        "tags": [
          "scanner"
        ],
        "summary": "Sync up to 500 offline scans (idempotent by scanId)",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "eventId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "scans": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "scanId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        "deviceTs": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "clockOffsetMs": {
                          "type": "integer"
                        },
                        "verdict": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "scanId",
                        "code",
                        "deviceTs",
                        "clockOffsetMs",
                        "verdict"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 500
                  }
                },
                "required": [
                  "eventId",
                  "scans"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server results per scan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "scanId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "result": {
                            "type": "string"
                          },
                          "stored": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "scanId",
                          "result",
                          "stored"
                        ]
                      }
                    },
                    "duplicatesOffline": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "results",
                    "duplicatesOffline"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown device token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices/heartbeat": {
      "post": {
        "tags": [
          "scanner"
        ],
        "summary": "Device health every 30 s; returns pending commands (wipe)",
        "security": [
          {
            "deviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "batteryPct": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "queueDepth": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "clockOffsetMs": {
                    "type": "integer"
                  }
                },
                "required": [
                  "queueDepth",
                  "clockOffsetMs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server time and commands",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "serverTime": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "wipe"
                        ]
                      }
                    }
                  },
                  "required": [
                    "serverTime",
                    "commands"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or unknown device token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "details": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
