{
  "openapi": "3.1.0",
  "info": {
    "title": "Yayatoh API",
    "version": "0.1.0",
    "description": "Yayatoh /v1. Changes are additive only (oasdiff gate)."
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "version",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
