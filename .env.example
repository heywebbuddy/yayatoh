# Names only. Real values live in Doppler (dev/preview/staging) — never production in this repo.
# Local development defaults are documented in docs/local-development.md.

# Postgres — runtime role (NOBYPASSRLS). Used by withTenant().
DATABASE_URL=
# Postgres — schema owner, used only by migrations (direct connection, never pooled).
MIGRATOR_DATABASE_URL=
# Postgres — superuser, used only by `pnpm db:bootstrap` on local/CI databases to create roles.
ADMIN_DATABASE_URL=
# Postgres — BYPASSRLS role; apps/admin and apps/worker only; every use is audited.
PLATFORM_READER_DATABASE_URL=

# Postgres — pg-boss queue schema (worker only; the migrator locally).
JOBS_DATABASE_URL=

# Better Auth — ≥32 random bytes per environment; the public origin of this host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# apps/api (api.yayatoh.com/v1): its public origin, and the /v1/mobile/config overrides as JSON
# (e.g. {"minimumVersions":{"ios":"3.0.0","android":"3.0.0"}}). apps/api shares BETTER_AUTH_SECRET
# with the web so bearer session tokens work on both.
API_PUBLIC_URL=
MOBILE_CONFIG_JSON=

# HMAC key for emailed tokens (invitations); ≥32 random bytes. Web and worker share it.
APP_TOKEN_SECRET=

# PDF renderer (ADR 0017): Gotenberg's private URL. Locally `docker compose up gotenberg` → http://localhost:3300.
# Unset = ticket PDF downloads are not offered.
GOTENBERG_URL=

# Dev/preview/CI only: 32-byte hex master key for the local key vault (AWS KMS in production).
LOCAL_KMS_KEY=

# Payments (roadmap §5.3): `fake` (default: dev/preview/CI hosted test pages) or `stripe`.
PAYMENTS_PROVIDER=
# Stripe (M1.5e). Test-mode keys outside production (sk_test_/rk_test_; live keys are refused there).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secrets of the platform webhook endpoint and of the Connect endpoint (connected accounts' events).
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Subscription billing (M6.6a, dormant): unset = off and nothing changes for any org. `1` turns it
# on (it still applies only to orgs with a billing customer). BILLING_PROVIDER: `fake` (default;
# dev/preview/CI, signed with a key derived from FAKE_PAYMENTS_SECRET) or `stripe`.
BILLING_ENABLED=
BILLING_PROVIDER=
# Signing secret of the Stripe billing webhook endpoint (/api/webhooks/billing/stripe).
STRIPE_BILLING_WEBHOOK_SECRET=

# Dev/preview/CI only: signs the fake payment provider's webhooks and the fake domain provider's
# verification tokens (never set in production).
FAKE_PAYMENTS_SECRET=
# Dev/preview/CI only: signs the fake email provider's delivery reports (M1.10d). Optional: derived
# from APP_TOKEN_SECRET when unset. EMAIL_PROVIDER=fake would allow the fake endpoint in production (never).
FAKE_EMAIL_WEBHOOK_SECRET=
# Messaging providers (M3.5b). Each is live only when switched on AND all of its names are set;
# otherwise dev/CI use the dev mailbox and production leaves messages queued (or falls back to the
# next channel). The staff console (Messaging providers) shows what is missing, by name only.
# EMAIL_PROVIDER=ses sends email through Amazon SES v2 (per-org sending identities; SNS events at
# /api/webhooks/email/ses). SES_SNS_TOPIC_ARN may list several topics, comma-separated.
EMAIL_PROVIDER=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_SESSION_TOKEN=
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=
# SMS_PROVIDER=twilio sends texts through Twilio Programmable Messaging (a Messaging Service, 10DLC);
# status callbacks at /api/webhooks/sms/twilio, inbound STOP/HELP at /api/webhooks/sms/twilio/inbound.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# WHATSAPP_PROVIDER=cloud, gateway or cloud,gateway (the first is the default route; decision P3-2).
# Cloud API webhooks at /api/webhooks/whatsapp/cloud (GET answers Meta's verify token); the owner's
# gateway (whatsapp.panitechnologies.com) calls back at /api/webhooks/whatsapp/gateway.
WHATSAPP_PROVIDER=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_KEY_ID=
WHATSAPP_GATEWAY_SECRET=
# The help link in the HELP reply to texts (support page); defaults to the app's home page.
MESSAGING_HELP_URL=

# Web push (M1.10e, RFC 8292 VAPID). Production: the owner generates the pair once with
# `pnpm vapid:generate` and stores it in Doppler (never in the repo). Dev/CI derive a stable pair
# from APP_TOKEN_SECRET when these are unset. VAPID_SUBJECT: mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Staff console origin (apps/admin; admin.yayatoh.com in production).
ADMIN_AUTH_URL=
# Staff passkeys (M1.2f): the WebAuthn relying-party id, the registrable domain (`yayatoh.com` in
# production). Defaults to ADMIN_AUTH_URL's host name.
PASSKEY_RP_ID=

# Google and Apple sign-in on the app host (M1.2f): `real` uses the owner's OAuth clients below (a
# provider without both values is not offered); `fake` (the default outside production) uses the
# fake consent page. Production is always `real`. Redirect URIs: {BETTER_AUTH_URL}/auth/social/{google|apple}/callback.
SOCIAL_SIGN_IN_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, and the client secret JWT signed with the Sign in with Apple key (renew ≤ 6 months).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Tenant sites apex (roadmap §4.2, owner decision D2); defaults to yayatoh.events.
TENANT_APEX=
# Host classes (M1.11, apps/web/src/lib/hosts.ts); comma-separated. Defaults: yayatoh.com,www.yayatoh.com,yayatoh.localhost and app.yayatoh.com.
MARKETPLACE_HOSTS=
APP_HOSTS=

# Coexistence front door (M2.4a, ADR 0020, docs/runbooks/front-door.md). Off unless an origin is set.
# LEGACY_ORIGIN_URL: the yayatoh.com instance's Laravel origin (hosts LEGACY_YAY_HOSTS, default yayatoh.com,www.yayatoh.com);
# LEGACY_ABC_ORIGIN_URL: abc's (hosts LEGACY_ABC_HOSTS, default abc.yayatoh.com). LEGACY_ORIGIN_SECRET goes to nginx as
# X-Yayatoh-Front-Door. Timeouts in ms (wait for legacy's headers, default 170000); body limit in bytes (default 64 MiB,
# also read at build time); flag cache and counter flush in ms (default 5000).
LEGACY_ORIGIN_URL=
LEGACY_ABC_ORIGIN_URL=
LEGACY_YAY_HOSTS=
LEGACY_ABC_HOSTS=
LEGACY_ORIGIN_SECRET=
FRONT_DOOR_TIMEOUT_MS=
FRONT_DOOR_MAX_BODY=
FRONT_DOOR_FLAG_TTL_MS=
FRONT_DOOR_FLUSH_MS=

# "Are you a person?" (M1.2f: emailed sign-in codes, sign-in after failed attempts, password resets,
# venue quotes; M1.7e: seat finder past its limit): `turnstile` (Cloudflare,
# owner account; needs both keys) or `fake` (default outside production: a test checkbox). Production
# without Turnstile keys has no challenge: over-limit lookups wait a minute instead.
HUMAN_CHECK_PROVIDER=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Open self-serve signup (M3.11a) also asks for this challenge. While signup is closed, the signup
# page links "Join the waitlist" here (an https: form or a mailto: address; hidden when unset).
SIGNUP_WAITLIST_URL=
# Realtime (M1.7f, M3.1b): SSE from the web app by default ("sse"); "ably" also publishes to Ably
# (owner account) with ABLY_API_KEY ("appId.keyId:secret") and enables browser token auth.
REALTIME_PROVIDER=
ABLY_API_KEY=
# Open realtime streams per org per web process (default 500).
REALTIME_MAX_STREAMS_PER_ORG=

# Local/preview only: enables /dev/login personas (never set in production).
YAYATOH_DEV_AUTH=
DEV_PERSONA_PASSWORD=

REDIS_URL=
SMTP_URL=

# Public origins
NEXT_PUBLIC_APP_ORIGIN=
API_ORIGIN=
# Notifications (M1.10): dev/preview write outbound messages here (read by /dev/mailbox). Defaults to $TMPDIR/yayatoh-dev-mailbox.
DEV_MAILBOX_DIR=

# Media storage (M1.4e). Empty = Postgres (dev/preview/CI only; refused when VERCEL_ENV=production).
# MEDIA_STORE=r2 with the owner's Cloudflare R2 bucket and an API token scoped to it.
MEDIA_STORE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=

# Cutover (M2.5a, docs/runbooks/cutover.md). Host routing (platform.ops_flags host_route) goes through the
# front door above: its LEGACY_ORIGIN_URL / LEGACY_ABC_ORIGIN_URL and LEGACY_ORIGIN_SECRET (batch 3c merge).
# The cutover tool refuses any database host but localhost/compose unless it is listed here
# (comma-separated staging hosts). Production hosts are never listed.
CUTOVER_STAGING_HOSTS=

# Analytics warehouse (M6.2a, decision P6-2). Empty or `postgres` = Postgres rollups (the default
# everywhere). `tinybird` = the Tinybird adapter: the API host, a DATASOURCES:APPEND token, the
# workspace admin token that signs per-org read JWTs, and the workspace id (owner account; none
# yet). TINYBIRD_API_URL=fake uses the in-memory fake (dev and CI only, never production).
ANALYTICS_WAREHOUSE=
TINYBIRD_API_URL=
TINYBIRD_APPEND_TOKEN=
TINYBIRD_SIGNING_KEY=
TINYBIRD_WORKSPACE_ID=
# Marketplace search v2 (M6.14a, decision P6-11): Meilisearch Cloud behind the SearchIndex port.
# Unset in dev and CI = the in-memory Meilisearch fake (also MEILISEARCH_URL=fake); unset in
# production = search v2 off (/search falls back to /events). Server-side only: the admin key
# writes the index (worker), the search-only key reads it (web). Index name defaults to
# yayatoh_listings. After configuring: pnpm --filter @yayatoh/worker search:reindex.
MEILISEARCH_URL=
MEILISEARCH_ADMIN_KEY=
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_INDEX=
# Integrations (M6.4a, decision P6-4). INTEGRATIONS_AUTH_PROVIDER=fake (the default outside production)
# uses the in-memory fake OAuth provider and the demo connector; =nango uses Nango (Cloud), which holds
# and refreshes the connectors' tokens (provider calls go through its proxy). Empty in production =
# integrations off. NANGO_HOST defaults to https://api.nango.dev.
INTEGRATIONS_AUTH_PROVIDER=
NANGO_SECRET_KEY=
NANGO_HOST=
