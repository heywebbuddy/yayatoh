# Names only. Real values live in Doppler (dev/preview/staging) — never production in this repo.
# Local development defaults are documented in docs/local-development.md.

# Postgres — runtime role (NOBYPASSRLS). Used by withTenant().
DATABASE_URL=
# Postgres — schema owner, used only by migrations (direct connection, never pooled).
MIGRATOR_DATABASE_URL=
# Postgres — superuser, used only by `pnpm db:bootstrap` on local/CI databases to create roles.
ADMIN_DATABASE_URL=
# Postgres — BYPASSRLS role; apps/admin and apps/worker only; every use is audited.
PLATFORM_READER_DATABASE_URL=

# Postgres — pg-boss queue schema (worker only; the migrator locally).
JOBS_DATABASE_URL=

# Better Auth — ≥32 random bytes per environment; the public origin of this host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# apps/api (api.yayatoh.com/v1): its public origin, and the /v1/mobile/config overrides as JSON
# (e.g. {"minimumVersions":{"ios":"3.0.0","android":"3.0.0"}}). apps/api shares BETTER_AUTH_SECRET
# with the web so bearer session tokens work on both.
API_PUBLIC_URL=
MOBILE_CONFIG_JSON=

# HMAC key for emailed tokens (invitations); ≥32 random bytes. Web and worker share it.
APP_TOKEN_SECRET=

# PDF renderer (ADR 0017): Gotenberg's private URL. Locally `docker compose up gotenberg` → http://localhost:3300.
# Unset = ticket PDF downloads are not offered.
GOTENBERG_URL=

# Dev/preview/CI only: 32-byte hex master key for the local key vault (AWS KMS in production).
LOCAL_KMS_KEY=

# Payments (roadmap §5.3): `fake` (default: dev/preview/CI hosted test pages) or `stripe`.
PAYMENTS_PROVIDER=
# Stripe (M1.5e). Test-mode keys outside production (sk_test_/rk_test_; live keys are refused there).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secrets of the platform webhook endpoint and of the Connect endpoint (connected accounts' events).
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Dev/preview/CI only: signs the fake payment provider's webhooks and the fake domain provider's
# verification tokens (never set in production).
FAKE_PAYMENTS_SECRET=
# Dev/preview/CI only: signs the fake email provider's delivery reports (M1.10d). Optional: derived
# from APP_TOKEN_SECRET when unset. EMAIL_PROVIDER=fake would allow the fake endpoint in production (never).
FAKE_EMAIL_WEBHOOK_SECRET=
EMAIL_PROVIDER=

# Web push (M1.10e, RFC 8292 VAPID). Production: the owner generates the pair once with
# `pnpm vapid:generate` and stores it in Doppler (never in the repo). Dev/CI derive a stable pair
# from APP_TOKEN_SECRET when these are unset. VAPID_SUBJECT: mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Staff console origin (apps/admin; admin.yayatoh.com in production).
ADMIN_AUTH_URL=
# Staff passkeys (M1.2f): the WebAuthn relying-party id, the registrable domain (`yayatoh.com` in
# production). Defaults to ADMIN_AUTH_URL's host name.
PASSKEY_RP_ID=

# Google and Apple sign-in on the app host (M1.2f): `real` uses the owner's OAuth clients below (a
# provider without both values is not offered); `fake` (the default outside production) uses the
# fake consent page. Production is always `real`. Redirect URIs: {BETTER_AUTH_URL}/auth/social/{google|apple}/callback.
SOCIAL_SIGN_IN_PROVIDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: the Services ID, and the client secret JWT signed with the Sign in with Apple key (renew ≤ 6 months).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Tenant sites apex (roadmap §4.2, owner decision D2); defaults to yayatoh.events.
TENANT_APEX=
# Host classes (M1.11, apps/web/src/lib/hosts.ts); comma-separated. Defaults: yayatoh.com,www.yayatoh.com,yayatoh.localhost and app.yayatoh.com.
MARKETPLACE_HOSTS=
APP_HOSTS=

# "Are you a person?" (M1.2f: emailed sign-in codes, sign-in after failed attempts, password resets,
# venue quotes; M1.7e: seat finder past its limit): `turnstile` (Cloudflare,
# owner account; needs both keys) or `fake` (default outside production: a test checkbox). Production
# without Turnstile keys has no challenge: over-limit lookups wait a minute instead.
HUMAN_CHECK_PROVIDER=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Open self-serve signup (M3.11a) also asks for this challenge. While signup is closed, the signup
# page links "Join the waitlist" here (an https: form or a mailto: address; hidden when unset).
SIGNUP_WAITLIST_URL=
# Realtime (M1.7f, M3.1b): SSE from the web app by default ("sse"); "ably" also publishes to Ably
# (owner account) with ABLY_API_KEY ("appId.keyId:secret") and enables browser token auth.
REALTIME_PROVIDER=
ABLY_API_KEY=
# Open realtime streams per org per web process (default 500).
REALTIME_MAX_STREAMS_PER_ORG=

# Local/preview only: enables /dev/login personas (never set in production).
YAYATOH_DEV_AUTH=
DEV_PERSONA_PASSWORD=

REDIS_URL=
SMTP_URL=

# Public origins
NEXT_PUBLIC_APP_ORIGIN=
API_ORIGIN=
# Notifications (M1.10): dev/preview write outbound messages here (read by /dev/mailbox). Defaults to $TMPDIR/yayatoh-dev-mailbox.
DEV_MAILBOX_DIR=

# Media storage (M1.4e). Empty = Postgres (dev/preview/CI only; refused when VERCEL_ENV=production).
# MEDIA_STORE=r2 with the owner's Cloudflare R2 bucket and an API token scoped to it.
MEDIA_STORE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
