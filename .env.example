# Names only. Real values live in Doppler (dev/preview/staging) — never production in this repo.
# Local development defaults are documented in docs/local-development.md.

# Postgres — runtime role (NOBYPASSRLS). Used by withTenant().
DATABASE_URL=
# Postgres — schema owner, used only by migrations (direct connection, never pooled).
MIGRATOR_DATABASE_URL=
# Postgres — superuser, used only by `pnpm db:bootstrap` on local/CI databases to create roles.
ADMIN_DATABASE_URL=
# Postgres — BYPASSRLS role; apps/admin and apps/worker only; every use is audited.
PLATFORM_READER_DATABASE_URL=

# Postgres — pg-boss queue schema (worker only; the migrator locally).
JOBS_DATABASE_URL=

# Better Auth — ≥32 random bytes per environment; the public origin of this host.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# HMAC key for emailed tokens (invitations); ≥32 random bytes. Web and worker share it.
APP_TOKEN_SECRET=

# PDF renderer (ADR 0017): Gotenberg's private URL. Locally `docker compose up gotenberg` → http://localhost:3300.
# Unset = ticket PDF downloads are not offered.
GOTENBERG_URL=

# Dev/preview/CI only: 32-byte hex master key for the local key vault (AWS KMS in production).
LOCAL_KMS_KEY=

# Payments (roadmap §5.3): `fake` (default: dev/preview/CI hosted test pages) or `stripe`.
PAYMENTS_PROVIDER=
# Stripe (M1.5e). Test-mode keys outside production (sk_test_/rk_test_; live keys are refused there).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secrets of the platform webhook endpoint and of the Connect endpoint (connected accounts' events).
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Dev/preview/CI only: signs the fake payment provider's webhooks and the fake domain provider's
# verification tokens (never set in production).
FAKE_PAYMENTS_SECRET=

# Staff console origin (apps/admin; admin.yayatoh.com in production).
ADMIN_AUTH_URL=

# Tenant sites apex (roadmap §4.2, owner decision D2); defaults to yayatoh.events.
TENANT_APEX=

# Local/preview only: enables /dev/login personas (never set in production).
YAYATOH_DEV_AUTH=
DEV_PERSONA_PASSWORD=

REDIS_URL=
SMTP_URL=

# Public origins
NEXT_PUBLIC_APP_ORIGIN=
API_ORIGIN=
