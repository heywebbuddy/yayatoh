{
  "name": "@yayatoh/checkin-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "yayatoh": {
    "kind": "universal"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vectors/verdicts.json": "./vectors/verdicts.json",
    "./vectors/lookup.json": "./vectors/lookup.json",
    "./vectors/first-wins.json": "./vectors/first-wins.json",
    "./vectors/scopes.json": "./vectors/scopes.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "vectors:write": "node tests/write-vectors.ts"
  },
  "devDependencies": {
    "@yayatoh/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@yayatoh/kernel": "workspace:*",
    "@yayatoh/ticket-crypto": "workspace:*"
  }
}
