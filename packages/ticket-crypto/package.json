{
  "name": "@yayatoh/ticket-crypto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "yayatoh": {
    "kind": "universal"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vectors/ticket-codes.json": "./vectors/ticket-codes.json",
    "./vectors/statements.json": "./vectors/statements.json",
    "./vectors/legacy.json": "./vectors/legacy.json",
    "./vectors/primitives.json": "./vectors/primitives.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "vectors:write": "node tests/write-vectors.ts"
  },
  "devDependencies": {
    "@yayatoh/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:"
  }
}
