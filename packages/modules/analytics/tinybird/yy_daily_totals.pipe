# M6.2a — read with a per-org JWT whose fixed_params pin org_id (the adapter also checks every row).

NODE latest
SQL >
    %
    SELECT event_id, max(version) AS v FROM yy_daily_rollups
    WHERE org_id = {{ String(org_id, required=True) }}
    GROUP BY event_id

NODE endpoint
SQL >
    %
    SELECT org_id, day, metric, currency, sum(value) AS value
    FROM yy_daily_rollups r
    INNER JOIN latest l ON r.event_id = l.event_id AND r.version = l.v
    WHERE r.org_id = {{ String(org_id, required=True) }}
      AND r.metric != '__snapshot'
      AND r.day BETWEEN {{ Date(from, required=True) }} AND {{ Date(to, required=True) }}
      {% if defined(event_id) %} AND r.event_id = {{ String(event_id) }} {% end %}
    GROUP BY org_id, day, metric, currency
