# ============================================================================
# Yayatoh 2.0 — PRODUCTION values, for DOPPLER only (project yayatoh, config "production")
# ============================================================================
#
# HOW TO USE
#  - Enter these in Doppler (doppler.com → project yayatoh → production → Add secret),
#    or import this file there once filled. NEVER in a claude.ai cloud environment,
#    never in the repo, never by email or chat.
#  - Generated secrets: run `openssl rand -hex 32` once per variable (never reuse a value
#    from another environment).
#  - The *_PROVIDER switches are set at go-live, following the runbook, with the owner.
# ============================================================================

# --- Database (Neon) and Redis (Upstash)
DATABASE_URL=
MIGRATOR_DATABASE_URL=
PLATFORM_READER_DATABASE_URL=
JOBS_DATABASE_URL=
REDIS_URL=

# --- Generated secrets (openssl rand -hex 32)
BETTER_AUTH_SECRET=
APP_TOKEN_SECRET=
LEGACY_ORIGIN_SECRET=
# Web push: run `pnpm vapid:generate` once; VAPID_SUBJECT = mailto:your-support-address
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Public addresses
BETTER_AUTH_URL=https://yayatoh.com
NEXT_PUBLIC_APP_ORIGIN=https://yayatoh.com
API_ORIGIN=https://api.yayatoh.com
API_PUBLIC_URL=https://api.yayatoh.com
ADMIN_AUTH_URL=https://admin.yayatoh.com
PASSKEY_RP_ID=yayatoh.com
TENANT_APEX=yayatoh.events
GOTENBERG_URL=
MESSAGING_HELP_URL=
SIGNUP_WAITLIST_URL=
MOBILE_CONFIG_JSON=

# --- Stripe LIVE (only at go-live, with the owner)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Amazon SES (production)
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
SES_SNS_TOPIC_ARN=

# --- Twilio (live account, 10DLC Messaging Service)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- WhatsApp
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_KEY_ID=
WHATSAPP_GATEWAY_SECRET=

# --- Sign-in, human check, realtime, media
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ABLY_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=

# --- Coexistence front door (at cutover only, per docs/runbooks/front-door.md)
LEGACY_ORIGIN_URL=
LEGACY_ABC_ORIGIN_URL=

# --- Provider switches: leave EMPTY until go-live (the runbook sets them)
PAYMENTS_PROVIDER=
EMAIL_PROVIDER=
SMS_PROVIDER=
WHATSAPP_PROVIDER=
SOCIAL_SIGN_IN_PROVIDER=
HUMAN_CHECK_PROVIDER=
REALTIME_PROVIDER=
MEDIA_STORE=
