# ============================================================================
# Yayatoh 2.0 — TEST / SANDBOX keys for the cloud environment "yayatoh-integrations"
# ============================================================================
#
# HOW TO USE
#  1. Fill in the value after each "=" (no quotes, no spaces around "=").
#  2. Leave a line empty if you don't have that service yet; it is simply skipped.
#  3. Paste the filled lines into: claude.ai/code → Environments → yayatoh-integrations
#     → Edit → Environment variables (or "API credentials" where offered).
#  4. Do NOT email or chat the filled file. Paste it straight into the environment,
#     then delete your local copy.
#
# RULES
#  - TEST / SANDBOX values only. Live or production keys never go here
#    (they go in Doppler, production config — see production.env).
#  - Do NOT add any *_PROVIDER, DATABASE_URL or other variable not listed here.
# ============================================================================

# --- Stripe (Dashboard → switch to "Test mode" → Developers → API keys / Webhooks)
# Must start with sk_test_ / pk_test_. Live keys (sk_live_) are refused.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Test-mode webhook signing secrets (whsec_...): one for the platform endpoint,
# one for the Connect endpoint (events from connected accounts).
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Amazon SES (AWS console → IAM: a user limited to SES; account still in the SES sandbox)
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Only if the credentials are temporary (otherwise leave empty):
AWS_SES_SESSION_TOKEN=
SES_CONFIGURATION_SET=
# One or more SNS topic ARNs for delivery events, comma-separated:
SES_SNS_TOPIC_ARN=

# --- Twilio (Console → Account → API keys & tokens → "Test credentials")
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API setup, test number)
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
# Any random string you choose; also entered in Meta's webhook settings:
WHATSAPP_CLOUD_VERIFY_TOKEN=

# --- WhatsApp gateway (whatsapp.panitechnologies.com — a TEST key)
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_KEY_ID=
WHATSAPP_GATEWAY_SECRET=

# --- Google sign-in (Google Cloud console → APIs & Services → Credentials → OAuth client, web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in (Apple Developer → Identifiers → Services ID; secret = signed JWT, renew within 6 months)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Cloudflare Turnstile (use Cloudflare's published TEST keys, or a test widget)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ably realtime (Ably dashboard → a sandbox app → API keys; format appId.keyId:secret)
ABLY_API_KEY=

# --- Cloudflare R2 media storage (a separate TEST bucket and an API token scoped to it)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=

# --- Neon (Neon console → Account → API keys; creates a database branch per preview)
NEON_API_KEY=
